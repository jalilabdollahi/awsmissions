{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListUploadsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pixelforge-uploads"
    },
    {
      "Sid": "WriteUserUploads",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::pixelforge-uploads/incoming/*"
    }
  ]
}
