{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SandboxReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::skyhook-sandbox-*",
        "arn:aws:s3:::skyhook-sandbox-*/*"
      ]
    }
  ]
}
