{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageKestrelFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:UpdateFunctionCode",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:kestrel-*"
    }
  ]
}
