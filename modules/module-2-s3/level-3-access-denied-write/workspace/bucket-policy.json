{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CiReadsBuilds",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::000000000000:user/ci-runner" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nimbus-build-artifacts/*"
    },
    {
      "Sid": "CiPublishesBuilds",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::000000000000:user/ci-runner" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::nimbus-build-artifacts"
    },
    {
      "Sid": "ReleaseManagerPublishes",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::000000000000:user/release-manager" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::nimbus-build-artifacts/releases/*"
    }
  ]
}
