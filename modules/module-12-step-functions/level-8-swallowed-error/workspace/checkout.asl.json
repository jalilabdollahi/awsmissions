{
  "Comment": "Pinecrest Tickets: take payment, then send the receipt",
  "StartAt": "ChargeCard",
  "States": {
    "ChargeCard": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:pinecrest-charge-card",
      "ResultPath": "$.payment",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "CheckoutFinished"
        }
      ],
      "Next": "SendReceipt"
    },
    "SendReceipt": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/pinecrest-receipts",
        "MessageBody.$": "States.JsonToString($)"
      },
      "Next": "CheckoutFinished"
    },
    "CheckoutFinished": {
      "Type": "Succeed"
    }
  }
}
