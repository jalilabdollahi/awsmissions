{
  "Comment": "Lumen Wholesale: score a new order for fraud, then queue it for the review desk",
  "StartAt": "ScoreOrder",
  "States": {
    "ScoreOrder": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:lumen-fraud-score",
      "Next": "QueueForReview"
    },
    "QueueForReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/lumen-review-desk",
        "MessageBody.$": "States.JsonToString($)"
      },
      "End": true
    }
  }
}
