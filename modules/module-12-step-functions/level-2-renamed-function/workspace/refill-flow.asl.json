{
  "Comment": "Harborview Pharmacy: decide whether a prescription refill can be approved",
  "StartAt": "CheckEligibility",
  "States": {
    "CheckEligibility": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:check-refill-eligibility",
      "Next": "RecordDecision"
    },
    "RecordDecision": {
      "Type": "Pass",
      "Parameters": {
        "rx.$": "$.rx",
        "approved.$": "$.approved",
        "ruleset.$": "$.ruleset"
      },
      "End": true
    }
  }
}
