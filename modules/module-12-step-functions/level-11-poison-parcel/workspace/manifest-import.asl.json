{
  "Comment": "Kestrel Logistics: validate every parcel of a nightly manifest",
  "StartAt": "EachParcel",
  "States": {
    "EachParcel": {
      "Type": "Map",
      "ItemsPath": "$.parcels",
      "MaxConcurrency": 5,
      "ItemSelector": {
        "parcel.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "ValidateParcel",
        "States": {
          "ValidateParcel": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:us-east-1:000000000000:function:kestrel-validate-parcel",
            "ResultPath": "$.validation",
            "Next": "AcceptParcel"
          },
          "AcceptParcel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Parameters": {
              "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/kestrel-accepted",
              "MessageBody": {
                "batchId.$": "$.batchId",
                "parcelId.$": "$.parcel.id",
                "routeCode.$": "$.validation.routeCode"
              }
            },
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
