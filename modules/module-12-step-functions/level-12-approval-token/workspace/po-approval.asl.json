{
  "Comment": "Brightline Procurement: hold a purchase order until a manager approves or rejects it",
  "StartAt": "AskManager",
  "States": {
    "AskManager": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 259200,
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/brightline-approvals",
        "MessageBody": {
          "poId.$": "$.poId",
          "amount.$": "$.amount",
          "requester.$": "$.requester",
          "taskToken": "$$.Task.Token"
        }
      },
      "Next": "IssuePurchaseOrder"
    },
    "IssuePurchaseOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/brightline-issued",
        "MessageBody": {
          "poId.$": "$.poId",
          "status": "ISSUED"
        }
      },
      "End": true
    }
  }
}
