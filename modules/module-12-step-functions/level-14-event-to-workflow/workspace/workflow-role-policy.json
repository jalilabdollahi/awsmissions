{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllocateStock",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:cedarpoint-allocate"
    },
    {
      "Sid": "WriteFulfilments",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/cedarpoint-fulfilments"
    }
  ]
}
