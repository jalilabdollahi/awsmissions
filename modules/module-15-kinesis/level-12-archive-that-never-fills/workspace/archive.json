{
  "RoleARN": "arn:aws:iam::000000000000:role/pageview-archive-role",
  "BucketARN": "arn:aws:s3:::pinecrest-archive",
  "Prefix": "raw/",
  "ErrorOutputPrefix": "archive-errors/!{firehose:error-output-type}/",
  "BufferingHints": {
    "SizeInMBs": 1,
    "IntervalInSeconds": 5
  },
  "CompressionFormat": "UNCOMPRESSED"
}
